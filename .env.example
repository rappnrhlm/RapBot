# ===================================================
# BOT WHATSAPP ENVIRONMENT CONFIGURATION
# ===================================================

# Web Admin Dashboard Authentication & Port
ADMIN_PIN=160509
WEB_PORT=3001

# Super Owner WhatsApp Number (e.g. 6281234567890)
SUPER_OWNER=

# MariaDB / MySQL Configuration (Optional - fallbacks to local JSON cache if unreachable)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bot_wa

# Inbound Webhook (Optional - RapBot forwards incoming WhatsApp messages here)
# WEBHOOK_URL=http://localhost:4000/webhook

# ===================================================
# AI EXTENSION CONFIGURATION (!ai)
# ===================================================
AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_DAILY_BUDGET_IDR=1000
AI_MONTHLY_BUDGET_IDR=25000
AI_MAX_OUTPUT_TOKENS=600
AI_MAX_INPUT_CHARS=2000
AI_COOLDOWN_SECONDS=5
AI_MAX_REQUESTS_PER_HOUR=10
AI_MAX_CONCURRENT_REQUESTS=2
AI_TIMEOUT_MS=20000
AI_USD_TO_IDR_RATE=16000
GEMINI_API_KEY=

